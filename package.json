{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts --port 3000",
    "prebuild": "node scripts/bump-version.mjs",
    "build": "tsc --noEmit && vite build && node scripts/check-performance-budget.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && rm -rf build && cp -r dist build",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist build server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --test --test-concurrency=4 --import ./scripts/offline-tests.mjs --import tsx server/tests/*.test.ts",
    "test:dev-runtime": "node scripts/check-dev-runtime.mjs",
    "postinstall": "node scripts/patch-firebase-auth.cjs",
    "verify:ai": "tsx scripts/verify-ai-models.ts",
    "map:generate": "node scripts/spider-map.mjs",
    "map:check": "node scripts/spider-map.mjs --check",
    "map:impact": "node scripts/spider-map.mjs --impact",
    "map:watch": "node scripts/spider-map.mjs --watch",
    "test:map": "node --test scripts/spider-map.test.mjs",
    "test:referrals": "node --test --import tsx server/tests/referralDurability.test.ts server/tests/referralContract.test.ts server/tests/referralApi.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sentry/node": "^11.4.0",
    "@sentry/react": "^11.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.9",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^13.1.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.64.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "undici": "8.12.3",
    "yahoo-finance2": "^4.0.2",
    "zod": "4.6.7"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "@types/express": "4.17.25",
    "@types/express-serve-static-core": "4.19.9",
    "body-parser@^1": "1.20.9",
    "body-parser@^2": "2.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "playwright": "1.64.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
