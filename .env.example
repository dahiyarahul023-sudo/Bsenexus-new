# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Telegram Bot Configuration (Recommended for persistence)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Application Security
APP_PIN=""
JWT_SECRET=""

# HTTP listener (Cloud Run injects PORT; local development defaults to 3000).
PORT="3000"

# Firebase Admin SDK Credentials (Service Account for Server-Side Firestore Access)
FIREBASE_SERVICE_ACCOUNT_KEY=""
FIREBASE_SERVICE_ACCOUNT=""
GOOGLE_APPLICATION_CREDENTIALS=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_PROJECT_ID=""

# Cashfree Payment Gateway Configuration
# Get these from Cashfree Merchant Dashboard -> Payment Gateway -> Developers -> API Keys
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENVIRONMENT="TEST" # Use "TEST" for Sandbox or "PRODUCTION" for Live
CASHFREE_API_VERSION="2023-08-01"
VITE_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SITE_KEY=""
RECAPTCHA_PROJECT_ID=""
RECAPTCHA_API_KEY=""
RECAPTCHA_MIN_SCORE="0.5"
RECAPTCHA_ALLOWED_HOSTNAMES=""

# BSE Egress Proxy (IP-block avoidance)
# BSE's Akamai WAF sometimes 403-blocks our cloud egress IP. Set this to route
# ALL BSE API requests through a clean-IP proxy (format: http://user:pass@host:port).
# Leave empty for direct fetching. Set via AI Studio Secrets / Cloud Run env vars.
BSE_PROXY_URL=""

# Supabase Configuration (Phase 1 Migration)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
MIGRATION_TOKEN=""

# Resend Transactional Email (One-tap Pro Receipts)
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=""
# Optional: verified custom sender (e.g. receipts@bsenexus.in).
# If unverified or empty, defaults to onboarding@resend.dev fallback.
RESEND_FROM_EMAIL="receipts@bsenexus.in"

# Sentry Error & Performance Monitoring
# Project: bsenexus
SENTRY_DSN="https://d57d9a4cbdfcec87d7a7d84bae5dc2a3@o4512192922255360.ingest.de.sentry.io/4512192924549200"
VITE_SENTRY_DSN="https://d57d9a4cbdfcec87d7a7d84bae5dc2a3@o4512192922255360.ingest.de.sentry.io/4512192924549200"

# OneSignal Web Push Notifications (Free & Pro alerts)
ONESIGNAL_APP_ID="f6cc3d33-a1bc-4c2a-992c-f36d0eccff6f"
VITE_ONESIGNAL_APP_ID="f6cc3d33-a1bc-4c2a-992c-f36d0eccff6f"
# REST API Key from OneSignal dashboard (Settings -> Keys & IDs)
ONESIGNAL_REST_API_KEY=""




