APP_PIN=
# Server-only public ownership token; when blank, loaded into this env var from public/indexnow-key.txt.
INDEXNOW_KEY=
# Select one primary submitter: server (default), cloudflare, or off. Check Crawler Hints before changing it.
INDEXNOW_SUBMITTER=server
BSE_PROXY_URL=
CASHFREE_API_VERSION=
CASHFREE_APP_ID=
CASHFREE_ENVIRONMENT=
CASHFREE_SECRET_KEY=
CRON_SECRET=
FIREBASE_API_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_DATABASE_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_SERVICE_ACCOUNT_KEY=
GEMINI_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GROQ_API_KEY=
JWT_SECRET=
MIGRATION_TOKEN=
NVIDIA_API_KEY=
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=
RECAPTCHA_API_KEY=
RECAPTCHA_MIN_SCORE=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_SITE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENTRY_DSN=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
VITE_APPCHECK_DEBUG_TOKEN=
VITE_APPCHECK_SITE_KEY=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_ONESIGNAL_APP_ID=
VITE_RECAPTCHA_SITE_KEY=
VITE_SENTRY_DSN=

# AI connections: enabled with canonical public origin.
AI_CONNECTIONS_ENABLED=true
AI_PUBLIC_ORIGIN=https://bsenexus.in

# Optional exact browser origins for other MCP clients (comma-separated; no wildcards).
AI_ALLOWED_ORIGINS=

# Optional dedicated directory-review account. Neither setting grants Pro or bypasses OAuth scopes.
# UID must be created with the mcp-reviewer- prefix; expiry must be within the next 31 days.
AI_REVIEWER_UID=
AI_REVIEWER_UNTIL=

# Personal Telegram proof (register via PIN-elevated POST /api/telegram/webhook/setup).
# Generate a 32+ character base64url secret; do not paste real secrets into Git.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://bsenexus.in/api/telegram/webhook
# Explicit owner Firebase UID for optional old admin-watchlist import. Empty disables it.
LEGACY_ADMIN_UID=
# Optional attestation must be configured on both server and browser.
FIREBASE_APPCHECK_ENFORCE=false
VITE_APPCHECK_ENFORCE=false
